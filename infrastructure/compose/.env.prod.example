# =============================================================================
# SereneMed production environment — template.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod is git-ignored. NEVER commit it, never paste its values into
# an issue or a doc. Every value below is a placeholder.
#
# Used twice: by `docker compose --env-file .env.prod` for ${...}
# substitution in docker-compose.prod.yml, and as the api container's
# env_file. Values with spaces or '#' need double quotes.
# =============================================================================

# --- Host -------------------------------------------------------------------
# Apex domain. Caddy serves api.<DOMAIN>, staff.<DOMAIN>, app.<DOMAIN>;
# all three need DNS A/AAAA records pointing at this machine.
DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=ops@example.com
# GitHub owner the images were published under (ghcr.io/<owner>/serenemed-*).
# Lowercase, as GHCR stores it.
GHCR_OWNER=your-github-org
# Image tag to run. "latest" tracks main; pin a commit SHA
# (sha-<40 hex chars>, as CI tags it) for a reproducible deploy/rollback.
TAG=latest
# Time zone the nightly backup clock uses, and the hh:mm it runs at.
CLINIC_TZ=Asia/Kolkata
BACKUP_AT=02:00

# --- Database ---------------------------------------------------------------
# Password for the "serenemed" superuser/owner role (used by prisma
# migrate and by the backup sidecar). Generate: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-long-random-string
# Password you set for the non-superuser "serenemed_app" role on first
# deploy (runbook step 4). Must differ from the dev value "serenemed_app"
# or the api refuses to boot.
APP_DB_PASSWORD=replace-with-another-long-random-string
# What the running api connects with: the NON-superuser role. A
# superuser bypasses Row-Level Security and every tenant policy stops
# applying. sslmode is REQUIRED (the api refuses to boot without one):
# "disable" is correct and deliberate here because Postgres is on the
# private compose network and the stock image has no TLS configured;
# use "require" (or "verify-full") the moment this points at a managed
# or off-machine database. Keep the password in sync with APP_DB_PASSWORD
# (compose does not substitute one variable inside another).
DATABASE_URL=postgresql://serenemed_app:replace-with-another-long-random-string@postgres:5432/serenemed?schema=public&connection_limit=10&pool_timeout=10&sslmode=disable
# Owner role, for `prisma migrate deploy` and the bootstrap script only.
# Keep the password in sync with POSTGRES_PASSWORD.
DIRECT_DATABASE_URL=postgresql://serenemed:replace-with-a-long-random-string@postgres:5432/serenemed?schema=public&sslmode=disable

# --- Redis ------------------------------------------------------------------
# Private network, no TLS. Use rediss:// if this ever leaves the machine.
REDIS_URL=redis://redis:6379

# --- Auth / secrets ---------------------------------------------------------
# Signs access + refresh tokens. Generate: openssl rand -base64 48
# Rotating it signs every user out (see runbook).
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Encrypts integration API keys stored in the database (AES-256-GCM).
# At least 32 characters. Generate: openssl rand -base64 48
# Losing it makes every saved integration key unreadable and there is
# no rotation tool yet — keep a copy in the password manager.
INTEGRATION_ENCRYPTION_KEY=replace-with-at-least-thirty-two-random-characters

# --- API behaviour ----------------------------------------------------------
# Browser origins allowed to call the api. Must match DOMAIN above.
CORS_ORIGINS=https://staff.example.com,https://app.example.com
# The clinic patients sign up to / log in to when the request does not
# name one (the patient app never does). Set it to the organization id
# created by the bootstrap script. MUST NOT be "seed-org" or
# "demo-clinic" — those are dev-seed clinics with public demo passwords
# and the api refuses to boot with either in production.
DEFAULT_ORGANIZATION_ID=acme-clinic
# Optional. Unset = error tracking is a no-op.
SENTRY_DSN=

# --- Uploaded files ---------------------------------------------------------
# Where the api writes patient documents (local-disk storage port,
# apps/api/src/storage/local-disk.storage.ts). Compose sets this to the
# "serenemed-storage" volume; the value here is informational and must
# match docker-compose.prod.yml. Local disk = ONE api instance only.
# The intended production target is an S3-compatible bucket through the
# existing S3_* variables (S3_ENDPOINT, S3_REGION, S3_BUCKET,
# S3_ACCESS_KEY, S3_SECRET_KEY) once a bucket is chosen and the adapter
# is built — not decided yet.
STORAGE_DIR=/data/storage

# --- Web images (build-time, not runtime) -----------------------------------
# Informational here: the two web images inline NEXT_PUBLIC_API_URL at
# build time from the GitHub repository variable of the same name. It
# must be https://api.<DOMAIN>. Changing it means rebuilding the images.
NEXT_PUBLIC_API_URL=https://api.example.com

# --- Backups (optional off-site copy) ---------------------------------------
# If set, backup.sh also uploads each dump with the aws CLI
# (`aws s3 cp`), to any S3-compatible bucket. Leave blank to keep
# backups only in the "backups" volume.
BACKUP_S3_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Only for non-AWS S3 (Cloudflare R2, Backblaze B2, MinIO).
AWS_ENDPOINT_URL=
# Retention: newest N daily dumps and newest N weekly (Sunday) dumps.
KEEP_DAILY=14
KEEP_WEEKLY=8
