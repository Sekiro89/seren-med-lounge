# =============================================================================
# SereneMed Lounge — environment configuration template
# Copy to .env at the repo root (and/or per-app .env.local) and fill in values.
# NEVER commit a real .env file.
# =============================================================================

# --- Core ---
NODE_ENV=development

# --- Database (PostgreSQL via Prisma) ---
# DATABASE_URL is what the running app connects with — it MUST be the
# non-superuser "serenemed_app" role (see
# infrastructure/docker/postgres-init/01-app-role.sql), never "serenemed"
# directly. Postgres superusers bypass Row-Level Security entirely, so
# connecting the app as one makes the tenant-isolation policies on
# clinics/users/patients silently do nothing — see
# docs/architecture/security.md#row-level-security.
DATABASE_URL=postgresql://serenemed_app:serenemed_app@localhost:5432/serenemed?schema=public
# DIRECT_DATABASE_URL is the privileged/owner role, used only by
# `prisma migrate` (schema changes, RLS policy management need it).
DIRECT_DATABASE_URL=postgresql://serenemed:serenemed@localhost:5432/serenemed?schema=public

# If port 5432 is already taken locally (a native Postgres install is a
# common culprit), set POSTGRES_HOST_PORT before `docker compose up` and
# update both URLs above to match — see docker-compose.yml.
# POSTGRES_HOST_PORT=5433

# --- Cache / Queues ---
REDIS_URL=redis://localhost:6379
# REDIS_HOST_PORT=6380  # same idea as POSTGRES_HOST_PORT, if 6379 is taken

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=serenemed-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Payments ---
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Messaging / WhatsApp ---
WHATSAPP_API_KEY=
MESSAGING_API_KEY=

# --- AI consultation assistant ---
AI_API_KEY=

# --- Zoho / Accounting ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Labs ---
LAB_API_URL=

# --- Insurance ---
INSURANCE_API_URL=

# --- App URLs / ports ---
API_PORT=4000
PATIENT_WEB_PORT=3000
STAFF_WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
