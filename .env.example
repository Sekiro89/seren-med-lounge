# =============================================================================
# SereneMed Lounge — environment configuration template
# Copy to .env at the repo root (and/or per-app .env.local) and fill in values.
# NEVER commit a real .env file.
# =============================================================================

# --- Core ---
NODE_ENV=development

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://serenemed:serenemed@localhost:5432/serenemed?schema=public

# --- Cache / Queues ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=serenemed-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Payments ---
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Messaging / WhatsApp ---
WHATSAPP_API_KEY=
MESSAGING_API_KEY=

# --- AI consultation assistant ---
AI_API_KEY=

# --- Zoho / Accounting ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Labs ---
LAB_API_URL=

# --- Insurance ---
INSURANCE_API_URL=

# --- App URLs / ports ---
API_PORT=4000
PATIENT_WEB_PORT=3000
STAFF_WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
