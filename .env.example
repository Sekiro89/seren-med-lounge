# =============================================================================
# SereneMed Lounge — environment configuration template
# Copy to .env at the repo root (and/or per-app .env.local) and fill in values.
# NEVER commit a real .env file.
# =============================================================================

# --- Core ---
NODE_ENV=development

# --- Database (PostgreSQL via Prisma) ---
# DATABASE_URL is what the running app connects with — it MUST be the
# non-superuser "serenemed_app" role (see
# infrastructure/docker/postgres-init/01-app-role.sql), never "serenemed"
# directly. Postgres superusers bypass Row-Level Security entirely, so
# connecting the app as one makes the tenant-isolation policies on
# clinics/users/patients silently do nothing — see
# docs/architecture/security.md#row-level-security.
#
# connection_limit is set explicitly rather than left to Prisma's default
# (num_cpus*2+1 — 17 on an 8-core dev machine, measured). That default is
# a footgun in containers: num_cpus often reflects the HOST's core count,
# not a container's CPU *limit*, so it can size a pool far larger than
# intended. Every tenant-scoped query opens a transaction (see
# PrismaService.withTenant), so this app holds more connections per
# request than a plain-query app would — worth being deliberate about.
# 10 is a starting point for one instance against docker-compose's
# Postgres (max_connections=100 by default — see
# docs/architecture/security.md#connection-pool-sizing for the math and
# a real concurrency measurement, not just this comment's assertion).
#
# PRODUCTION: both URLs below must include an explicit sslmode param —
# app boot refuses to start without one (packages/config/src/env.ts).
# Add "&sslmode=require" (or "verify-full" with a CA cert) unless the DB
# is deliberately private-network-only, in which case set
# "sslmode=disable" explicitly rather than leaving it unset — libpq's
# default ("prefer") silently falls back to plaintext if the server
# doesn't offer TLS. See docs/architecture/security.md#encryption-in-transit.
DATABASE_URL=postgresql://serenemed_app:serenemed_app@localhost:5432/serenemed?schema=public&connection_limit=10&pool_timeout=10
# DIRECT_DATABASE_URL is the privileged/owner role, used only by
# `prisma migrate` (schema changes, RLS policy management need it).
DIRECT_DATABASE_URL=postgresql://serenemed:serenemed@localhost:5432/serenemed?schema=public

# If port 5432 is already taken locally (a native Postgres install is a
# common culprit), set POSTGRES_HOST_PORT before `docker compose up` and
# update both URLs above to match — see docker-compose.yml.
# POSTGRES_HOST_PORT=5433

# --- Cache / Queues ---
# PRODUCTION: use "rediss://" (note the extra "s") instead of "redis://"
# if the Redis instance isn't on a private network the app already
# trusts — ioredis enables TLS automatically from the URL scheme, no
# code change needed. Not boot-enforced like the DATABASE_URL sslmode
# check above (unlike Postgres's sslmode=prefer, there's no silent
# downgrade to plaintext here — redis:// vs rediss:// is an explicit,
# deliberate choice either way) — see
# docs/architecture/security.md#encryption-in-transit.
REDIS_URL=redis://localhost:6379
# REDIS_HOST_PORT=6380  # same idea as POSTGRES_HOST_PORT, if 6379 is taken

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=serenemed-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Payments ---
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Messaging / WhatsApp ---
WHATSAPP_API_KEY=
MESSAGING_API_KEY=

# --- AI consultation assistant ---
AI_API_KEY=

# --- Zoho / Accounting ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Labs ---
LAB_API_URL=

# --- Insurance ---
INSURANCE_API_URL=

# --- Error tracking ---
# Unset by default — Sentry.init() only runs if this is set (see
# main.ts), so leaving it blank is a real no-op, not a half-broken
# integration. See docs/architecture/deployment.md for what's actually
# verified about this wiring versus what still needs a real account.
SENTRY_DSN=

# --- App URLs / ports ---
API_PORT=4000
PATIENT_WEB_PORT=3000
STAFF_WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated list of origins the API will accept cross-origin
# requests from (see apps/api/src/main.ts's app.enableCors() call). The
# default below covers the two local frontend dev ports — set this to
# the real deployed frontend origin(s) in any other environment, or
# patient-web/staff-web won't be able to call the API from a browser at
# all (CORS blocks it, not a bug in the app).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
