// SereneMed Lounge — initial Prisma schema.
//
// INTENTIONALLY MINIMAL. This bootstraps the multi-tenant shell and the
// root of the Unified Patient Record so migrations/tooling can be
// exercised end to end. It is NOT the full domain model.
//
// The proposed full ERD (Appointment, Encounter, ClinicalNote +
// versioning, Prescription, LabOrder, Invoice, Payment, InsuranceCase,
// CarePlan, AuditLog detail, etc.) is documented in
// docs/database/erd.md and gets added table-by-table as each backend
// module is implemented — see docs/architecture/domain-modules.md.
//
// Keep StaffRole in sync by hand with packages/types/src/roles.ts
// (Prisma cannot import a TS enum) until/unless we generate one from the other.
//
// SOFT DELETE CONVENTION: any model holding data that must be retained
// (i.e. almost everything except AuditLog, which is an immutable log and
// must never be deleted at all) gets a `deletedAt DateTime?` field. Adding
// that field is most of the convention — PrismaService's query extension
// (src/prisma/soft-delete.extension.ts) detects it automatically at
// runtime via the DMMF and excludes soft-deleted rows from
// find/findFirst/count by default. `.delete()`/`.deleteMany()` on these
// models throw rather than running — call `.update({ data: { deletedAt:
// new Date() } })` directly instead. (An earlier version tried to
// transparently rewrite delete->update; it silently broke tenant
// isolation inside transactions — see the comment above the delete
// handler in soft-delete.extension.ts for why.) See
// docs/architecture/security.md#soft-delete.
//
// TENANT ISOLATION: every table with organizationId (Clinic/User/Patient/
// AuditLog) has Postgres Row-Level Security policies applied in the
// migration SQL (Prisma's schema language cannot express RLS) — see
// prisma/migrations/20260921000000_init/migration.sql,
// prisma/migrations/20260921010000_audit_log_organization/migration.sql,
// and docs/architecture/security.md#row-level-security. RLS only works
// because the app connects as a non-superuser role — see
// infrastructure/docker/postgres-init/01-app-role.sql.
//
// AuditLog.organizationId is required, not optional: every actor today
// (User, Patient) already belongs to exactly one organization, so every
// auditable action has one to record. A future cross-org/platform-level
// admin action would need a different answer — not guessed at here, see
// docs/architecture/open-questions.md#9.
//
// CLINICAL RECORD VERSIONING (ClinicalNote/ClinicalNoteVersion): proves
// the "never overwrite finalized clinical records" requirement for
// real, not just in a comment. ClinicalNote is a mutable "thread"
// pointer (current status + which version is latest); every actual
// state — DRAFT, FINALIZED, an AMENDED correction — is a brand new
// ClinicalNoteVersion row. ClinicalNoteVersion has no `deletedAt` (like
// AuditLog) AND, unlike AuditLog, the app's own DB role has UPDATE and
// DELETE actively revoked on it in the migration SQL — see
// prisma/migrations/20260921090000_clinic_journey_spine/migration.sql.
// So this isn't "the app promises not to update it," it's "the app
// physically cannot" — a bug that tries anyway gets a Postgres
// permission error, not silently-corrupted history. See
// docs/architecture/security.md#clinical-record-versioning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries (the query engine) use `url` — this MUST be a
  // non-superuser role (see infrastructure/docker/postgres-init/01-app-role.sql).
  // Postgres superusers always bypass Row-Level Security, so if the app
  // connects as a superuser, the RLS tenant-isolation policies on
  // clinics/users/patients silently do nothing. `prisma migrate`
  // commands use `directUrl` instead — that one runs as the privileged
  // role, since schema changes and RLS/policy management need it.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum StaffRole {
  ADMINISTRATOR
  RECEPTION
  NURSE
  JUNIOR_DOCTOR
  SENIOR_DOCTOR
  SURGERY_COORDINATOR
  LAB_TECHNICIAN
  PHARMACY
  BILLING
  INSURANCE
  MARKETING
}

/// Tenancy root. A deployment can host multiple organizations later;
/// today there is exactly one, but every table hangs off this from day one.
model Organization {
  id                       String                    @id @default(cuid())
  name                     String
  clinics                  Clinic[]
  users                    User[]
  patients                 Patient[]
  auditLogs                AuditLog[]
  appointments             Appointment[]
  encounters               Encounter[]
  vitals                   Vital[]
  clinicalNotes            ClinicalNote[]
  deletedAt                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  clinicalNoteVersions     ClinicalNoteVersion[]
  diagnoses                Diagnosis[]
  diagnosisVersions        DiagnosisVersion[]
  prescriptions            Prescription[]
  prescriptionItems        PrescriptionItem[]
  labOrders                LabOrder[]
  labOrderItems            LabOrderItem[]
  labResults               LabResult[]
  patientDocuments         PatientDocument[]
  patientConsents          PatientConsent[]
  patientClaimRequests     PatientClaimRequest[]
  patientActivationTokens  PatientActivationToken[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  payments                 Payment[]
  refunds                  Refund[]
  registrations            Registration[]
  queueEntries             QueueEntry[]
  medicalHistoryEntries    MedicalHistoryEntry[]
  metabolicWorkups         MetabolicWorkup[]
  medications              Medication[]
  stockBatches             StockBatch[]
  stockMovements           StockMovement[]
  dispensings              Dispensing[]
  referrals                Referral[]
  procedures               Procedure[]
  procedureChecklistItems  ProcedureChecklistItem[]
  carePlans                CarePlan[]
  followUps                FollowUp[]
  reviewRequests           ReviewRequest[]
  reviews                  Review[]
  campaigns                Campaign[]
  leads                    Lead[]
  leadActivities           LeadActivity[]
  insurancePolicies        InsurancePolicy[]
  insuranceCases           InsuranceCase[]
  insuranceCaseEvents      InsuranceCaseEvent[]
  clinicalTemplates        ClinicalTemplate[]
  clinicalTemplateVersions ClinicalTemplateVersion[]
  doctorAvailability       DoctorAvailability[]
  staffTasks               StaffTask[]
  notifications            Notification[]
  messageThreads           MessageThread[]
  messages                 Message[]

  @@index([deletedAt])
  @@map("organizations")
}

/// A physical/operational clinic location under an organization.
model Clinic {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  name               String
  users              User[]
  patients           Patient[]
  appointments       Appointment[]
  encounters         Encounter[]
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  queueEntries       QueueEntry[]
  doctorAvailability DoctorAvailability[]

  @@index([organizationId, deletedAt])
  @@map("clinics")
}

/// Staff identity — NOT the patient identity (see Patient below). Kept
/// separate deliberately: staff auth/roles and patient auth/consent are
/// different concerns and must never be merged into one "users" table.
model User {
  id                              String                    @id @default(cuid())
  organizationId                  String
  organization                    Organization              @relation(fields: [organizationId], references: [id])
  clinicId                        String?
  clinic                          Clinic?                   @relation(fields: [clinicId], references: [id])
  email                           String
  passwordHash                    String
  fullName                        String
  role                            StaffRole
  isActive                        Boolean                   @default(true)
  authoredNotes                   ClinicalNoteVersion[]
  authoredDiagnoses               DiagnosisVersion[]
  prescriptions                   Prescription[]
  labOrders                       LabOrder[]
  labResultsEntered               LabResult[]
  documentsUploaded               PatientDocument[]
  consentsRecorded                PatientConsent[]
  activationTokensIssued          PatientActivationToken[]
  invoicesIssued                  Invoice[]                 @relation("InvoiceIssuedBy")
  invoicesVoided                  Invoice[]                 @relation("InvoiceVoidedBy")
  paymentsReceived                Payment[]
  refundsIssued                   Refund[]
  deletedAt                       DateTime?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  doctorAppointments              Appointment[]             @relation("AppointmentDoctor")
  registrationsRecorded           Registration[]
  medicalHistoryRecorded          MedicalHistoryEntry[]
  metabolicWorkupsRecorded        MetabolicWorkup[]
  stockBatchesReceived            StockBatch[]
  stockMovements                  StockMovement[]
  dispensings                     Dispensing[]
  referralsReceived               Referral[]                @relation("ReferralTo")
  referralsMade                   Referral[]                @relation("ReferralFrom")
  proceduresPerformed             Procedure[]               @relation("ProcedurePerformer")
  proceduresCreated               Procedure[]               @relation("ProcedureCreator")
  checklistItemsCompleted         ProcedureChecklistItem[]
  carePlansCreated                CarePlan[]
  followUpsAssigned               FollowUp[]                @relation("FollowUpAssignee")
  followUpsCreated                FollowUp[]                @relation("FollowUpCreator")
  followUpsResolved               FollowUp[]                @relation("FollowUpResolver")
  reviewRequestsMade              ReviewRequest[]
  reviewsModerated                Review[]
  campaignsCreated                Campaign[]
  leadsOwned                      Lead[]                    @relation("LeadOwner")
  leadActivities                  LeadActivity[]
  insuranceCasesCreated           InsuranceCase[]
  insuranceCaseEvents             InsuranceCaseEvent[]
  clinicalTemplatesCreated        ClinicalTemplate[]
  clinicalTemplateVersionsCreated ClinicalTemplateVersion[]
  availability                    DoctorAvailability[]      @relation("DoctorAvailability")
  tasksAssigned                   StaffTask[]               @relation("TaskAssignee")
  tasksCreated                    StaffTask[]               @relation("TaskCreator")
  notifications                   Notification[]            @relation("NotificationRecipient")
  threadsAssigned                 MessageThread[]           @relation("ThreadAssignee")
  messagesSent                    Message[]                 @relation("MessageSender")

  // Scoped to the organization, not global — the same person can hold
  // separate staff accounts at two different organizations under one
  // email. See docs/architecture/open-questions.md.
  //
  // NOTE: this constraint does not account for deletedAt — re-inviting a
  // soft-deleted former staff member under the same email will hit this
  // unique constraint rather than silently reusing the row. That's
  // deliberate for now (forces an explicit "restore" action instead of a
  // surprise reactivation); see docs/architecture/security.md#soft-delete.
  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([clinicId])
  @@map("users")
}

/// Root of the Unified Patient Record. Every other domain (clinical,
/// billing, pharmacy, follow-up, CRM/lead-once-converted, timeline) will
/// attach to this same Patient row by patientId — never duplicated per
/// module. See docs/database/erd.md.
model Patient {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  clinicId          String?
  clinic            Clinic?                  @relation(fields: [clinicId], references: [id])
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  phone             String
  email             String?
  passwordHash      String?
  appointments      Appointment[]
  encounters        Encounter[]
  vitals            Vital[]
  clinicalNotes     ClinicalNote[]
  diagnoses         Diagnosis[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  documents         PatientDocument[]
  consents          PatientConsent[]
  activationTokens  PatientActivationToken[]
  invoices          Invoice[]
  deletedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  registrations     Registration[]
  queueEntries      QueueEntry[]
  medicalHistory    MedicalHistoryEntry[]
  metabolicWorkups  MetabolicWorkup[]
  dispensings       Dispensing[]
  referrals         Referral[]
  procedures        Procedure[]
  carePlans         CarePlan[]
  followUps         FollowUp[]
  reviewRequests    ReviewRequest[]
  reviews           Review[]
  leadsReferred     Lead[]                   @relation("LeadReferredBy")
  convertedFromLead Lead?                    @relation("LeadConvertedTo")
  insurancePolicies InsurancePolicy[]
  insuranceCases    InsuranceCase[]
  staffTasks        StaffTask[]
  notifications     Notification[]
  messageThreads    MessageThread[]

  // Nullable-safe: Postgres doesn't treat NULLs as equal for uniqueness,
  // so many patients with no email yet is fine — this only rejects two
  // patients in the same org both claiming the same actual email.
  // Mirrors User's (organizationId, email) constraint — see its comment
  // for why scoped to org, not global.
  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([clinicId])
  @@index([phone])
  @@map("patients")
}

/// Foundational audit trail — see docs/architecture/security.md.
/// Detailed per-domain audit needs (e.g. clinical note amendment history)
/// get their own tables later; this is the generic cross-cutting log.
///
/// No deletedAt — an audit trail must never be deletable, soft or
/// otherwise (see the SOFT DELETE CONVENTION note above).
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorType      String // "USER" | "PATIENT" | "SYSTEM"
  actorId        String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// CLINIC JOURNEY SPINE — the first vertical slice past the identity/auth
// shell (Organization/Clinic/User/Patient/AuditLog). Deliberately scoped
// to prove two previously-unproven patterns end to end — RLS/soft-delete
// at a second reference point, and clinical record versioning for real —
// before the rest of docs/database/erd.md's proposed tables get built.
// See docs/architecture/security.md#clinical-record-versioning and
// docs/workflows/clinic-journey.md.
//
// Keep these enums in sync by hand with packages/types/src/journey.ts and
// clinical-record-status.ts — same caveat as StaffRole above.
// =============================================================================

enum AppointmentEntrySource {
  ONLINE_BOOKING
  RECEPTION_WALK_IN
  VIDEO_CONSULTATION
  CAMP
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  OPEN
  IN_CONSULTATION
  CLOSED
}

enum ClinicalRecordStatus {
  DRAFT
  AI_DRAFT
  REVIEWED
  FINALIZED
  AMENDED
}

enum ClinicalRecordSource {
  MANUAL
  AI_ASSISTED
}

/// Deliberately simpler than ClinicalRecordStatus — a prescription is
/// issued directly by an authorized prescriber (no draft/review cycle;
/// see the doc comment on the Prescription model below for why), then
/// only ever cancelled, never edited. No FINALIZED/AMENDED here: a
/// correction cancels this prescription and issues a new one.
enum PrescriptionStatus {
  ACTIVE
  CANCELLED
}

/// Same two-state shape as PrescriptionStatus, same reasoning: ordering
/// tests is one authorized action, not a reviewed draft. No COMPLETED
/// state — "when is an order complete" (all items resulted? partial
/// results allowed?) isn't a concretely askable question yet without
/// guessing at lab workflow product intent, so it's left undecided
/// rather than modeled on a guess.
enum LabOrderStatus {
  ORDERED
  CANCELLED
}

/// Conservative starting set, traced directly to what the OPD
/// registration workflow actually asks for — expand as real screens
/// need more (see docs/architecture/open-questions.md#2's "expand only
/// as each workspace's real screens need it" precedent).
enum PatientDocumentType {
  PHOTO
  ID_PROOF
  INSURANCE_CARD
  PAN_CARD
  CONSENT_FORM
  OTHER
}

/// Same conservative-set reasoning as PatientDocumentType, traced to the
/// proposal's DF-tagged bullets: OPD registration consent, the AI
/// consult assistant's "consent recording," and reviews published "with
/// consent."
enum PatientConsentType {
  TREATMENT
  DATA_SHARING
  AI_CONSULT_RECORDING
  MARKETING_COMMUNICATION
}

enum PatientConsentAction {
  GRANTED
  REVOKED
}

/// Entry point of the clinic journey (see docs/workflows/clinic-journey.md).
/// Checking in an appointment creates its Encounter — one multi-table
/// transaction, see AppointmentsService.checkIn().
model Appointment {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?                @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient                @relation(fields: [patientId], references: [id])
  encounter      Encounter?
  entrySource    AppointmentEntrySource
  status         AppointmentStatus      @default(REQUESTED)
  scheduledAt    DateTime
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  doctorId       String?
  doctor         User?                  @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  followUp       FollowUp?

  @@index([organizationId, deletedAt])
  @@index([patientId])
  @@index([clinicId])
  @@index([doctorId, scheduledAt])
  @@map("appointments")
}

/// One visit's clinical record root — vitals and clinical notes attach
/// here, not directly to Patient, since they belong to a specific visit.
/// patientId is denormalized from appointment.patientId (not derived via
/// join) so Vital/ClinicalNote queries scoped to a patient don't need to
/// traverse through Appointment — same rationale as Patient.clinicId
/// being denormalized rather than requiring a Clinic join everywhere.
model Encounter {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  clinicId         String?
  clinic           Clinic?           @relation(fields: [clinicId], references: [id])
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id])
  appointmentId    String            @unique
  appointment      Appointment       @relation(fields: [appointmentId], references: [id])
  vitals           Vital[]
  clinicalNotes    ClinicalNote[]
  diagnoses        Diagnosis[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  invoices         Invoice[]
  status           EncounterStatus   @default(OPEN)
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  registration     Registration?
  queueEntry       QueueEntry?
  metabolicWorkups MetabolicWorkup[]
  referrals        Referral[]
  procedures       Procedure[]
  carePlans        CarePlan[]
  insuranceCases   InsuranceCase[]

  @@index([organizationId, deletedAt])
  @@index([patientId])
  @@map("encounters")
}

/// Intake/vitals for one encounter. Ordinary soft-delete (a mistyped
/// reading gets corrected via update, not versioned like ClinicalNote —
/// vitals aren't the "clinical record" the immutability requirement in
/// docs/architecture/security.md targets).
model Vital {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  patientId              String
  patient                Patient      @relation(fields: [patientId], references: [id])
  encounterId            String
  encounter              Encounter    @relation(fields: [encounterId], references: [id])
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulseBpm               Int?
  spo2Percent            Int?
  temperatureCelsius     Float?
  bmi                    Float?
  recordedAt             DateTime     @default(now())
  deletedAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  respiratoryRate        Int?
  heightCm               Float?
  weightKg               Float?

  @@index([organizationId, deletedAt])
  @@index([encounterId])
  @@map("vitals")
}

/// Mutable "thread" pointer — current status and which version is
/// latest. NOT the clinical record itself; see ClinicalNoteVersion and
/// the CLINICAL RECORD VERSIONING note above. Soft-deletable (deleting
/// the thread, e.g. created in error, is different from amending a
/// finalized version's content).
model ClinicalNote {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id])
  patientId            String
  patient              Patient                  @relation(fields: [patientId], references: [id])
  encounterId          String
  encounter            Encounter                @relation(fields: [encounterId], references: [id])
  versions             ClinicalNoteVersion[]
  status               ClinicalRecordStatus     @default(DRAFT)
  currentVersionNumber Int                      @default(0)
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  noteType             ClinicalNoteType         @default(CONSULTATION)
  procedureId          String?
  procedure            Procedure?               @relation(fields: [procedureId], references: [id])
  templateVersionId    String?
  templateVersion      ClinicalTemplateVersion? @relation(fields: [templateVersionId], references: [id])

  @@index([organizationId, deletedAt])
  @@index([encounterId])
  @@index([patientId])
  @@map("clinical_notes")
}

/// The actual clinical documentation — append-only, never updated or
/// deleted once written (see the CLINICAL RECORD VERSIONING note above
/// and the REVOKE UPDATE/DELETE in this migration's SQL). A SOAP-note
/// shape (subjective/objective/assessment/plan) — a concrete, common
/// clinical documentation structure rather than one vague "content"
/// blob. organizationId is denormalized from clinicalNote (required for
/// RLS — the policy checks this table's own column, not a joined one).
model ClinicalNoteVersion {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  clinicalNoteId String
  clinicalNote   ClinicalNote         @relation(fields: [clinicalNoteId], references: [id])
  versionNumber  Int
  status         ClinicalRecordStatus
  source         ClinicalRecordSource @default(MANUAL)
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  authorId       String
  author         User                 @relation(fields: [authorId], references: [id])
  createdAt      DateTime             @default(now())

  @@unique([clinicalNoteId, versionNumber])
  @@index([organizationId])
  @@map("clinical_note_versions")
}

/// Mutable "thread" pointer for a diagnosis — same shape as ClinicalNote
/// above (see the CLINICAL RECORD VERSIONING note): current status and
/// which version is latest, not the diagnosis content itself. See
/// DiagnosisVersion and docs/architecture/security.md#clinical-record-immutability,
/// which already names diagnoses as expected to follow this pattern.
model Diagnosis {
  id                   String               @id @default(cuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id])
  patientId            String
  patient              Patient              @relation(fields: [patientId], references: [id])
  encounterId          String
  encounter            Encounter            @relation(fields: [encounterId], references: [id])
  versions             DiagnosisVersion[]
  status               ClinicalRecordStatus @default(DRAFT)
  currentVersionNumber Int                  @default(0)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([organizationId, deletedAt])
  @@index([encounterId])
  @@index([patientId])
  @@map("diagnoses")
}

/// The actual diagnosis content — append-only, never updated or deleted
/// once written, exactly like ClinicalNoteVersion (same REVOKE UPDATE/
/// DELETE treatment in this migration's SQL). organizationId is
/// denormalized from diagnosis (required for RLS — the policy checks
/// this table's own column, not a joined one).
model DiagnosisVersion {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  diagnosisId    String
  diagnosis      Diagnosis            @relation(fields: [diagnosisId], references: [id])
  versionNumber  Int
  status         ClinicalRecordStatus
  icdCode        String?
  description    String
  authorId       String
  author         User                 @relation(fields: [authorId], references: [id])
  createdAt      DateTime             @default(now())

  @@unique([diagnosisId, versionNumber])
  @@index([organizationId])
  @@map("diagnosis_versions")
}

/// Unlike ClinicalNote/Diagnosis, deliberately NOT a draft/sign-off/amend
/// pointer — the permission matrix only has one `prescription:write`
/// slug (no separate sign-off), because issuing a prescription is a
/// single authorized action, not a multi-step review. This row itself
/// stays mutable (status ACTIVE -> CANCELLED — a lifecycle transition,
/// same as Appointment.status/Encounter.status elsewhere in this
/// schema), but the actual prescribed content lives in PrescriptionItem,
/// which is immutable once written. Correcting a prescription means
/// cancelling this one and issuing a new one — never editing an item.
model Prescription {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  encounterId    String
  encounter      Encounter          @relation(fields: [encounterId], references: [id])
  items          PrescriptionItem[]
  status         PrescriptionStatus @default(ACTIVE)
  authorId       String
  author         User               @relation(fields: [authorId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, deletedAt])
  @@index([encounterId])
  @@index([patientId])
  @@map("prescriptions")
}

/// One prescribed medication line. Append-only, never updated or
/// deleted once written (REVOKE UPDATE/DELETE in this migration's SQL,
/// same treatment as ClinicalNoteVersion/DiagnosisVersion) — this is the
/// actual clinical content the immutability requirement targets.
/// organizationId is denormalized from prescription (required for RLS).
model PrescriptionItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicationName String
  dosage         String
  frequency      String
  durationDays   Int?
  instructions   String?
  createdAt      DateTime     @default(now())
  dispensings    Dispensing[]

  @@index([organizationId])
  @@index([prescriptionId])
  @@map("prescription_items")
}

/// Same shape as Prescription — see its doc comment for the reasoning
/// (mutable lifecycle pointer + immutable content children). Ordering
/// tests is a single authorized action (lab-order:write), not a
/// reviewed draft.
model LabOrder {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  encounterId    String
  encounter      Encounter      @relation(fields: [encounterId], references: [id])
  items          LabOrderItem[]
  status         LabOrderStatus @default(ORDERED)
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, deletedAt])
  @@index([encounterId])
  @@index([patientId])
  @@map("lab_orders")
}

/// One ordered test (e.g. "CBC", "Lipid Panel"). Append-only, never
/// updated or deleted once written (REVOKE UPDATE/DELETE in this
/// migration's SQL, same treatment as PrescriptionItem) — the ordered
/// test itself is fixed; cancelling and reordering is the correction
/// path, not editing this row. organizationId is denormalized from
/// labOrder (required for RLS).
model LabOrderItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  labOrderId     String
  labOrder       LabOrder     @relation(fields: [labOrderId], references: [id])
  testName       String
  instructions   String?
  results        LabResult[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([labOrderId])
  @@map("lab_order_items")
}

/// A reported result for one ordered test. Append-only, never updated or
/// deleted once written (REVOKE UPDATE/DELETE, same treatment as every
/// other immutable clinical-content table in this schema) — a wrong or
/// updated result is entered as a NEW row against the same
/// LabOrderItem, never an edit of the original; the latest by
/// `createdAt` is the current one. Deliberately references
/// LabOrderItem, not LabOrder directly, unlike the loose ASCII sketch in
/// docs/database/erd.md's proposed section — a result belongs to one
/// specific ordered test, and an order can have several tests, so
/// attaching it to LabOrder directly would leave "which test is this
/// the result for" unanswered. `resultValue` is a plain string (not
/// numeric-only) because lab results are often qualitative
/// ("Positive"/"Negative"/"Reactive"), not always a number.
model LabResult {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  labOrderItemId String
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id])
  resultValue    String
  unit           String?
  referenceRange String?
  enteredById    String
  enteredBy      User         @relation(fields: [enteredById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([labOrderItemId])
  @@map("lab_results")
}

/// Document metadata only — no upload mechanism is built here. Real
/// object storage (`.env.example`'s `S3_*` vars) has a documented
/// destination but no client integration yet (open-questions.md#7 is
/// still open on the provider). `storageKey` assumes a file was already
/// placed in that bucket by a future upload flow; building a fake
/// upload path now would repeat the "fake integration" mistake this
/// project explicitly avoids elsewhere (see patient phone/OTP login).
/// Ordinary soft-delete, not the immutable-content pattern — a document
/// (e.g. a blurry ID photo) can legitimately need replacing, unlike a
/// clinical record.
model PatientDocument {
  id                     String              @id @default(cuid())
  organizationId         String
  organization           Organization        @relation(fields: [organizationId], references: [id])
  patientId              String
  patient                Patient             @relation(fields: [patientId], references: [id])
  documentType           PatientDocumentType
  storageKey             String
  fileName               String
  mimeType               String
  uploadedById           String
  uploadedBy             User                @relation(fields: [uploadedById], references: [id])
  deletedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  registrationsAsIdProof Registration[]
  proceduresAsConsent    Procedure[]
  insurancePolicies      InsurancePolicy[]

  @@index([organizationId, deletedAt])
  @@index([patientId])
  @@map("patient_documents")
}

/// Append-only, never updated or deleted once written — REVOKE UPDATE,
/// DELETE in this migration's SQL, same treatment as every other
/// immutable-content table in this schema, and more important here than
/// almost anywhere else: a consent record is exactly the kind of thing
/// that must never be silently edited. "Is the patient currently
/// consented for X" is answered by the latest row for
/// (patientId, consentType), ordered by createdAt — there's no separate
/// mutable pointer table (unlike ClinicalNote/Diagnosis), since a
/// consent's only two states (GRANTED/REVOKED) don't need one.
model PatientConsent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient              @relation(fields: [patientId], references: [id])
  consentType    PatientConsentType
  action         PatientConsentAction
  recordedById   String
  recordedBy     User                 @relation(fields: [recordedById], references: [id])
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([patientId, consentType])
  @@map("patient_consents")
}

enum PatientClaimStatus {
  PENDING
  ESCALATED
  LINKED
  CREATED_NEW
  REJECTED
}

/// Who initiated the signup/intake attempt this claim came from — the
/// same claim-case machinery (matching, staff resolution, audit) now
/// serves two different front doors, not two different tables. See
/// PatientClaimRequest's own doc comment.
enum PatientClaimSource {
  SELF_SIGNUP
  RECEPTION_INTAKE
}

/// Patient Record Claim Rules — see docs/architecture/open-questions.md#3.
/// Holds an identity that couldn't be confidently resolved to exactly one
/// existing Patient record on its own — either a patient's self-signup
/// (PatientsService.selfRegister, `source: SELF_SIGNUP`, always carries
/// `email`+`passwordHash`) or Reception's "create patient" flow
/// (`PatientsService.register`, `source: RECEPTION_INTAKE`, never carries
/// credentials — Reception is finding/creating a RECORD, never an
/// ACCOUNT, see the "Reception must not impersonate the patient" rule).
/// `matchReason` records which signal produced the ambiguity (e.g.
/// "phone_dob_multiple", "name_dob_different_phone") since candidate
/// count alone can't distinguish a POSSIBLE_MATCH (name+DOB matched, a
/// different phone) from an AMBIGUOUS_MATCH (phone+DOB matched, but the
/// name doesn't) — both can have exactly one candidate.
///
/// The submitted identity (+ password, when there is one) lives HERE,
/// not on any Patient row, specifically so a pending/ambiguous attempt
/// can never silently create or mutate a Patient record on its own —
/// only a staff member resolving this request (PatientClaimsService)
/// does that. Mutable by design (status/resolved* change on resolution)
/// — not the immutable-content pattern used elsewhere, this is an
/// operational queue, not a clinical record.
model PatientClaimRequest {
  id                  String             @id @default(cuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id])
  source              PatientClaimSource @default(SELF_SIGNUP)
  matchReason         String
  firstName           String
  lastName            String
  dateOfBirth         DateTime
  phone               String
  email               String?
  passwordHash        String?
  candidatePatientIds Json
  status              PatientClaimStatus @default(PENDING)
  resolvedPatientId   String?
  resolvedById        String?
  resolvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())

  @@index([organizationId, status])
  @@map("patient_claim_requests")
}

/// A one-time, staff-issued code that lets a patient who already has an
/// unclaimed Patient record set their own password — the "Send Account
/// Activation" action (see open-questions.md's Patient Record Claim
/// Rules entry). Deliberately NOT an SMS/email OTP: no messaging
/// integration exists in this project (same "no fake integrations"
/// reasoning as phone/OTP login), so the code is generated here and
/// handed to Reception to relay to the patient by whatever channel
/// they already use in person — never sent automatically. `codeHash` is
/// a SHA-256 digest (not bcrypt): this needs exact-match lookup by the
/// code itself, not verification against one already-known row, and a
/// short-lived, single-use, org-scoped random code doesn't need
/// bcrypt's slow-hash/timing protection the way a long-lived password
/// does. The raw code is returned to the caller exactly once, at
/// creation, and is never persisted or logged in plaintext.
model PatientActivationToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  codeHash       String
  expiresAt      DateTime
  usedAt         DateTime?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([patientId])
  @@map("patient_activation_tokens")
}

// =============================================================================
// BILLING — Invoice/InvoiceItem (invoices module), Payment/Refund (payments
// module). See docs/workflows/billing.md.
//
// MONEY: every amount is an Int in the currency's minor unit (paise for
// INR) — never Float/Decimal-as-float, so totals add up exactly. CHECK
// constraints in the migration SQL keep amounts non-negative and an
// invoice's paidMinor within [0, totalMinor] at the database level.
//
// Same "mutable lifecycle pointer + immutable content" shape as
// Prescription/LabOrder: Invoice.status/paidMinor move, while
// InvoiceItem/Payment/Refund are REVOKE UPDATE, DELETE — a wrong invoice
// is voided and reissued, a wrong payment is refunded, nothing is edited.
// =============================================================================

/// No DRAFT state (unlike @serenemed/types' InvoiceStatus) — an invoice
/// is issued in one step with its items, same as a Prescription; nothing
/// uses a draft yet, so the state isn't stored until something does.
enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum InvoiceItemType {
  CONSULTATION
  PROCEDURE
  LAB
  PHARMACY
  OTHER
}

/// Only methods a staff member can record as already-received money.
/// CREDIT (an unpaid balance) is simply an invoice that isn't PAID yet and
/// SPLIT is several Payment rows on one invoice. INSURANCE is written only
/// by the insurance module when a case is SETTLED — never through the
/// billing desk's POST /invoices/:id/payments.
/// Online/gateway payments need PaymentProvider (still a stub — see
/// docs/architecture/integrations.md) and will add a status lifecycle
/// when built; every row here is money already in hand.
enum PaymentMethod {
  CASH
  UPI
  CARD
  INSURANCE
}

/// `number` is a per-organization sequence (allocated under an advisory
/// lock in InvoicesService, with the unique constraint as the backstop);
/// it's displayed as INV-000001. TODO(compliance): GST invoice-number
/// format, prefix, and financial-year reset are not decided — see
/// docs/architecture/open-questions.md#15.
///
/// subtotal/tax/total are computed server-side from the items at issue
/// time and never change afterwards. paidMinor is the running net
/// (payments minus refunds), recomputed in the same transaction as every
/// Payment/Refund insert, so listing invoices never needs a sum query.
model Invoice {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  number         Int
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?      @relation(fields: [encounterId], references: [id])
  status         InvoiceStatus   @default(ISSUED)
  currency       String          @default("INR")
  subtotalMinor  Int
  taxMinor       Int
  totalMinor     Int
  paidMinor      Int             @default(0)
  notes          String?
  items          InvoiceItem[]
  payments       Payment[]
  issuedById     String
  issuedBy       User            @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  voidedById     String?
  voidedBy       User?           @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  voidedAt       DateTime?
  voidReason     String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  insuranceCases InsuranceCase[]

  @@unique([organizationId, number])
  @@index([organizationId, deletedAt])
  @@index([patientId])
  @@index([encounterId])
  @@map("invoices")
}

/// One billed line. Append-only (REVOKE UPDATE, DELETE). taxMinor is the
/// line's tax amount as entered by billing staff — no GST-rate/HSN logic
/// exists yet (TODO(compliance), open-questions.md#15). lineTotalMinor =
/// quantity * unitPriceMinor + taxMinor, computed server-side.
/// TODO(product): no price catalogue exists, so description/price are
/// entered per line rather than picked from a service list.
model InvoiceItem {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  itemType       InvoiceItemType
  description    String
  quantity       Int
  unitPriceMinor Int
  taxMinor       Int             @default(0)
  lineTotalMinor Int
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@map("invoice_items")
}

/// Money received against an invoice. Append-only (REVOKE UPDATE,
/// DELETE) — a mistaken payment is corrected with a Refund, never by
/// editing or deleting this row. `reference` is the UPI transaction id /
/// card slip number, if any — never a full card number.
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  method         PaymentMethod
  amountMinor    Int
  reference      String?
  receivedById   String
  receivedBy     User          @relation(fields: [receivedById], references: [id])
  refunds        Refund[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

/// A distinct record from Payment, not a negative payment row (per
/// docs/workflows/billing.md), so refund and payment history stay
/// separately auditable. Append-only (REVOKE UPDATE, DELETE). The sum of
/// a payment's refunds can never exceed that payment — enforced in
/// PaymentsService under a row lock on the parent invoice.
model Refund {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id])
  amountMinor    Int
  reason         String
  issuedById     String
  issuedBy       User         @relation(fields: [issuedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([paymentId])
  @@map("refunds")
}

// =============================================================================
// OPD REGISTRATION, TOKEN QUEUE, INTAKE — registration, queue,
// medical-history and vitals modules. See docs/workflows/clinic-journey.md.
// =============================================================================

enum VisitType {
  NEW_CONSULTATION
  FOLLOW_UP
  REPORT_REVIEW
  PROCEDURE
}

/// The diagram's "Consultation Route": A = junior doctor assessment
/// first, B = direct to senior doctor.
enum ConsultationRoute {
  JUNIOR_ASSESSMENT
  DIRECT_SENIOR
}

/// Where the patient currently is in the clinic, so each desk can pull
/// its own queue.
enum QueueStation {
  VITALS
  JUNIOR_DOCTOR
  SENIOR_DOCTOR
  BILLING
  PHARMACY
  LAB
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
}

enum MedicalHistoryCategory {
  ALLERGY
  CONDITION
  PAST_SURGERY
  CURRENT_MEDICATION
  FAMILY_HISTORY
  SOCIAL_HISTORY
}

enum MedicalHistoryStatus {
  ACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum GlucoseContext {
  FASTING
  RANDOM
  POST_PRANDIAL
}

/// OPD registration for one visit — created at check-in time against the
/// Encounter (one per encounter). Patient identity fields stay on Patient;
/// this row holds only what's per-visit: visit type, consultation route,
/// ID-proof verification, and the case-based cancer-check flag.
/// TODO(product): "ID proof — required" is enforced as "verified, or an
/// ID_PROOF PatientDocument on file" — see open-questions.md#16.
model Registration {
  id                      String            @id @default(cuid())
  organizationId          String
  organization            Organization      @relation(fields: [organizationId], references: [id])
  patientId               String
  patient                 Patient           @relation(fields: [patientId], references: [id])
  encounterId             String            @unique
  encounter               Encounter         @relation(fields: [encounterId], references: [id])
  visitType               VisitType
  consultationRoute       ConsultationRoute
  idProofDocumentId       String?
  idProofDocument         PatientDocument?  @relation(fields: [idProofDocumentId], references: [id])
  idProofVerified         Boolean           @default(false)
  cancerScreeningRequired Boolean           @default(false)
  notes                   String?
  registeredById          String
  registeredBy            User              @relation(fields: [registeredById], references: [id])
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([organizationId])
  @@index([patientId])
  @@map("registrations")
}

/// The visit's queue token. tokenNumber is sequential per organization
/// per queueDate (allocated under an advisory lock in QueueService; the
/// unique constraint is the backstop). One entry per encounter — the
/// patient moves between stations on the same token rather than getting
/// a new one at each desk.
/// TODO(product): per-clinic token series (today: per organization).
model QueueEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  encounterId    String       @unique
  encounter      Encounter    @relation(fields: [encounterId], references: [id])
  queueDate      DateTime     @db.Date
  tokenNumber    Int
  station        QueueStation
  status         QueueStatus  @default(WAITING)
  calledAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, queueDate, tokenNumber])
  @@index([organizationId, queueDate, station, status])
  @@map("queue_entries")
}

/// Patient-level history (not per visit): allergies, conditions, past
/// surgeries, current medications, family/social history. Rows are never
/// deleted — a wrong entry is marked ENTERED_IN_ERROR, a resolved
/// condition RESOLVED, and every change is audited — so the history of
/// what clinicians were told stays reconstructable.
model MedicalHistoryEntry {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient                @relation(fields: [patientId], references: [id])
  category       MedicalHistoryCategory
  description    String
  severity       AllergySeverity?
  status         MedicalHistoryStatus   @default(ACTIVE)
  recordedById   String
  recordedBy     User                   @relation(fields: [recordedById], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId])
  @@index([patientId, category])
  @@map("medical_history_entries")
}

/// The diagram's separate/optional metabolic workup, per encounter.
/// Same mutability as Vital (a mistyped reading is corrected, not
/// versioned). Point-of-care readings — a sent-out lab test still goes
/// through LabOrder/LabResult.
model MetabolicWorkup {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id])
  patientId            String
  patient              Patient         @relation(fields: [patientId], references: [id])
  encounterId          String
  encounter            Encounter       @relation(fields: [encounterId], references: [id])
  glucoseMgDl          Float?
  glucoseContext       GlucoseContext?
  hba1cPercent         Float?
  totalCholesterolMgDl Float?
  ldlMgDl              Float?
  hdlMgDl              Float?
  triglyceridesMgDl    Float?
  bodyFatPercent       Float?
  muscleMassKg         Float?
  visceralFatLevel     Float?
  otherTests           Json?
  recordedById         String
  recordedBy           User            @relation(fields: [recordedById], references: [id])
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([organizationId, deletedAt])
  @@index([encounterId])
  @@map("metabolic_workups")
}

// =============================================================================
// PHARMACY & INVENTORY — inventory module (Medication, StockBatch,
// StockMovement), pharmacy module (Dispensing). See
// docs/workflows/pharmacy.md: dispensing always references the
// PrescriptionItem it fulfils, stock is allocated FEFO
// (first-expiry-first-out), and delivery is a status on Dispensing.
// =============================================================================

enum MedicationForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  DROPS
  INHALER
  OTHER
}

/// RECEIPT/RETURN add stock, DISPENSE/WASTAGE remove it, ADJUSTMENT is a
/// stock-count correction either way (CHECK constraint enforces the sign).
enum StockMovementType {
  RECEIPT
  DISPENSE
  RETURN
  ADJUSTMENT
  WASTAGE
}

/// PREPARED = medicines picked and stock allocated (the diagram's
/// "pharmacy ready"); then HANDED_OVER at the counter, or
/// OUT_FOR_DELIVERY -> DELIVERED for home delivery. Only a PREPARED
/// dispensing can be CANCELLED, which returns its stock.
enum DispensingStatus {
  PREPARED
  HANDED_OVER
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfilmentMode {
  PICKUP
  HOME_DELIVERY
}

/// The pharmacy catalogue. `unit` is the dispensing unit ("tablet",
/// "ml", "tube"); every quantity in this section counts that unit.
/// reorderLevel drives the low-stock list.
model Medication {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  genericName    String?
  form           MedicationForm
  strength       String?
  unit           String
  unitPriceMinor Int?
  reorderLevel   Int?
  isActive       Boolean         @default(true)
  batches        StockBatch[]
  movements      StockMovement[]
  dispensings    Dispensing[]
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@map("medications")
}

/// One received batch. quantityOnHand is the running balance — it only
/// changes together with a StockMovement row in the same transaction,
/// and a CHECK keeps it >= 0, so the batch can never go negative even
/// under a bug. Movements are the audit trail; this is the fast read.
model StockBatch {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  medicationId     String
  medication       Medication      @relation(fields: [medicationId], references: [id])
  batchNumber      String
  expiryDate       DateTime        @db.Date
  quantityReceived Int
  quantityOnHand   Int
  unitCostMinor    Int?
  supplier         String?
  receivedById     String
  receivedBy       User            @relation(fields: [receivedById], references: [id])
  movements        StockMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([organizationId, medicationId, batchNumber])
  @@index([medicationId, expiryDate])
  @@map("stock_batches")
}

/// Append-only stock ledger (REVOKE UPDATE, DELETE). Every change to a
/// batch's quantityOnHand has exactly one row here; a DISPENSE/RETURN
/// row also names the Dispensing it belongs to, so which batches a
/// dispense drew from (and what a cancellation must return) is recorded.
model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  batchId        String
  batch          StockBatch        @relation(fields: [batchId], references: [id])
  medicationId   String
  medication     Medication        @relation(fields: [medicationId], references: [id])
  type           StockMovementType
  quantityDelta  Int
  reason         String?
  dispensingId   String?
  dispensing     Dispensing?       @relation(fields: [dispensingId], references: [id])
  actorId        String
  actor          User              @relation(fields: [actorId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([batchId])
  @@index([medicationId, createdAt])
  @@index([dispensingId])
  @@map("stock_movements")
}

/// Medicines given out against one prescribed line. Several dispensings
/// per line are allowed (partial supply, refills).
/// TODO(product): PrescriptionItem has no total quantity (dosage /
/// frequency / duration are free text), so over-dispensing against the
/// prescription can't be checked — open-questions.md#16.
model Dispensing {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id])
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicationId       String
  medication         Medication       @relation(fields: [medicationId], references: [id])
  quantity           Int
  status             DispensingStatus @default(PREPARED)
  mode               FulfilmentMode
  deliveryAddress    String?
  movements          StockMovement[]
  dispensedById      String
  dispensedBy        User             @relation(fields: [dispensedById], references: [id])
  handedOverAt       DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([patientId])
  @@index([prescriptionItemId])
  @@map("dispensings")
}

// =============================================================================
// REFERRALS, PROCEDURES & SURGERY — referrals and procedures modules
// (surgery is a Procedure with kind = SURGERY, gated by surgery:manage).
// Operative (OT) notes and discharge summaries are ClinicalNotes with a
// noteType, so they get the same draft -> sign-off -> amend versioning.
// =============================================================================

enum ReferralType {
  INTERNAL
  EXTERNAL
}

enum ReferralUrgency {
  ROUTINE
  URGENT
  EMERGENCY
}

enum ReferralStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ProcedureKind {
  PROCEDURE
  SURGERY
}

/// PLANNED (estimate stage) -> SCHEDULED (date + doctor set) ->
/// IN_PROGRESS (only once consent is attached and every pre-op checklist
/// item is done) -> COMPLETED. CANCELLED from PLANNED or SCHEDULED.
enum ProcedureStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClinicalNoteType {
  CONSULTATION
  PROGRESS
  OPERATIVE
  DISCHARGE_SUMMARY
}

/// INTERNAL = to another doctor in this organization (toUserId);
/// EXTERNAL = to an outside doctor/facility (toName/toFacility). CHECK
/// constraint enforces the matching target fields.
model Referral {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  encounterId    String
  encounter      Encounter       @relation(fields: [encounterId], references: [id])
  type           ReferralType
  toUserId       String?
  toUser         User?           @relation("ReferralTo", fields: [toUserId], references: [id])
  toName         String?
  toFacility     String?
  toSpecialty    String?
  reason         String
  urgency        ReferralUrgency @default(ROUTINE)
  status         ReferralStatus  @default(OPEN)
  outcomeNote    String?
  referredById   String
  referredBy     User            @relation("ReferralFrom", fields: [referredById], references: [id])
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([patientId])
  @@index([toUserId, status])
  @@map("referrals")
}

/// A planned procedure or surgery, raised from the encounter where it was
/// decided. estimateMinor is the quoted cost (paise) shown to the patient;
/// it isn't an invoice — billing still issues one.
/// consentDocumentId must point at a CONSENT_FORM PatientDocument before
/// the procedure can start.
model Procedure {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  patientId         String
  patient           Patient                  @relation(fields: [patientId], references: [id])
  encounterId       String
  encounter         Encounter                @relation(fields: [encounterId], references: [id])
  kind              ProcedureKind
  name              String
  notes             String?
  estimateMinor     Int?
  status            ProcedureStatus          @default(PLANNED)
  scheduledAt       DateTime?
  location          String?
  performedById     String?
  performedBy       User?                    @relation("ProcedurePerformer", fields: [performedById], references: [id])
  consentDocumentId String?
  consentDocument   PatientDocument?         @relation(fields: [consentDocumentId], references: [id])
  checklist         ProcedureChecklistItem[]
  clinicalNotes     ClinicalNote[]
  createdById       String
  createdBy         User                     @relation("ProcedureCreator", fields: [createdById], references: [id])
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  reviewRequests    ReviewRequest[]
  insuranceCases    InsuranceCase[]

  @@index([organizationId, status])
  @@index([patientId])
  @@index([performedById, scheduledAt])
  @@map("procedures")
}

/// One pre-op checklist line (e.g. "NPO since midnight", "Blood
/// arranged"). Ticked/unticked with audit; every line must be ticked
/// before the procedure can start.
/// TODO(product): default checklist per procedure type — today the
/// coordinator adds the lines.
model ProcedureChecklistItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  procedureId    String
  procedure      Procedure    @relation(fields: [procedureId], references: [id])
  label          String
  completedAt    DateTime?
  completedById  String?
  completedBy    User?        @relation(fields: [completedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([procedureId])
  @@map("procedure_checklist_items")
}

// =============================================================================
// POST-TREATMENT CARE & FOLLOW-UP — care-plans and followups modules.
// Discharge (EncountersService.discharge) closes the encounter and can
// create the CarePlan + first FollowUps in the same transaction. See
// docs/workflows/follow-up.md.
// =============================================================================

enum CarePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  REVIEW_APPOINTMENT
  MEDICATION_REMINDER
  RECOVERY_CHECK
  REPORT_ALERT
  OTHER
}

/// PENDING until a staff member records the outcome. ESCALATED = the
/// check-in found a problem and it was handed to a doctor (the diagram's
/// "Escalation"); it stays open until completed.
enum FollowUpStatus {
  PENDING
  DONE
  MISSED
  ESCALATED
  CANCELLED
}

model CarePlan {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id])
  patientId             String
  patient               Patient        @relation(fields: [patientId], references: [id])
  encounterId           String?
  encounter             Encounter?     @relation(fields: [encounterId], references: [id])
  title                 String
  dischargeInstructions String?
  status                CarePlanStatus @default(ACTIVE)
  followUps             FollowUp[]
  createdById           String
  createdBy             User           @relation(fields: [createdById], references: [id])
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([patientId])
  @@map("care_plans")
}

/// One scheduled post-treatment touchpoint. A REVIEW_APPOINTMENT is
/// booked through the appointments module (appointmentId), not a
/// separate booking mechanism.
/// TODO(integration): reminders are worklist items for staff today —
/// no SMS/WhatsApp provider is contracted to send them to the patient.
model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  carePlanId     String?
  carePlan       CarePlan?      @relation(fields: [carePlanId], references: [id])
  type           FollowUpType
  dueAt          DateTime
  notes          String?
  status         FollowUpStatus @default(PENDING)
  outcome        String?
  assignedToId   String?
  assignedTo     User?          @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  appointmentId  String?        @unique
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  createdById    String
  createdBy      User           @relation("FollowUpCreator", fields: [createdById], references: [id])
  resolvedById   String?
  resolvedBy     User?          @relation("FollowUpResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  escalatedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([patientId])
  @@index([assignedToId, status])
  @@map("follow_ups")
}

// =============================================================================
// REVIEWS & TESTIMONIALS — reviews module. Consent-based: a request is only
// made if the patient's latest MARKETING_COMMUNICATION consent is GRANTED;
// publishing needs the patient's explicit publishConsent on the review.
// =============================================================================

enum ReviewStage {
  AFTER_SECOND_CONSULTATION
  AFTER_FIRST_FOLLOW_UP
  AFTER_PROCEDURE
}

enum ReviewRequestStatus {
  REQUESTED
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum ReviewFormat {
  TEXT
  VIDEO
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One ask, per patient per stage (per procedure for AFTER_PROCEDURE):
/// dedupeKey = "<stage>:<procedureId or ->", unique per patient.
model ReviewRequest {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id])
  stage          ReviewStage
  procedureId    String?
  procedure      Procedure?          @relation(fields: [procedureId], references: [id])
  dedupeKey      String
  status         ReviewRequestStatus @default(REQUESTED)
  expiresAt      DateTime
  review         Review?
  requestedById  String
  requestedBy    User                @relation(fields: [requestedById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, patientId, dedupeKey])
  @@index([organizationId, status])
  @@map("review_requests")
}

/// The patient's submitted review. Content (rating, comment, video,
/// publishConsent) is fixed once submitted; only moderation fields
/// change. A VIDEO testimonial stores object-storage metadata only (no
/// upload client exists yet — same as PatientDocument).
model Review {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient                @relation(fields: [patientId], references: [id])
  requestId        String                 @unique
  request          ReviewRequest          @relation(fields: [requestId], references: [id])
  stage            ReviewStage
  rating           Int
  comment          String?
  format           ReviewFormat           @default(TEXT)
  videoStorageKey  String?
  publishConsent   Boolean                @default(false)
  moderationStatus ReviewModerationStatus @default(PENDING)
  moderatedById    String?
  moderatedBy      User?                  @relation(fields: [moderatedById], references: [id])
  moderatedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([organizationId, moderationStatus])
  @@index([patientId])
  @@map("reviews")
}

// =============================================================================
// MARKETING FUNNEL & CRM — leads and campaigns modules. A Lead converts
// into exactly one Patient (convertedPatientId) through the same
// duplicate-detection PatientsService.register uses — never a parallel
// patient record. See docs/workflows/marketing-funnel.md.
// =============================================================================

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  CAMPAIGN
  REFERRAL
  CAMP
  WALK_IN
}

enum LeadStatus {
  NEW
  CONTACTED
  NURTURING
  APPOINTMENT_BOOKED
  CONVERTED
  LOST
}

enum LeadActivityType {
  CALL
  MESSAGE
  EMAIL
  MEETING
  NOTE
  EDUCATION_SENT
  STATUS_CHANGE
}

enum CampaignType {
  DIGITAL
  HEALTH_CAMP
  EVENT
  REFERRAL_PROGRAM
  OTHER
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Includes health camps (type HEALTH_CAMP, with location + dates).
model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  type           CampaignType
  channel        String?
  status         CampaignStatus @default(PLANNED)
  startsAt       DateTime?
  endsAt         DateTime?
  location       String?
  budgetMinor    Int?
  notes          String?
  leads          Lead[]
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, deletedAt])
  @@map("campaigns")
}

/// A prospective patient. Contact consent is recorded on the lead itself
/// (there's no Patient yet to hang a PatientConsent on); it carries over
/// as a MARKETING_COMMUNICATION consent on conversion.
model Lead {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id])
  firstName           String
  lastName            String?
  phone               String
  email               String?
  source              LeadSource
  campaignId          String?
  campaign            Campaign?      @relation(fields: [campaignId], references: [id])
  referredByPatientId String?
  referredByPatient   Patient?       @relation("LeadReferredBy", fields: [referredByPatientId], references: [id])
  ownerId             String?
  owner               User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  status              LeadStatus     @default(NEW)
  enquiry             String?
  consentToContact    Boolean        @default(false)
  consentRecordedAt   DateTime?
  nextFollowUpAt      DateTime?
  lostReason          String?
  convertedPatientId  String?        @unique
  convertedPatient    Patient?       @relation("LeadConvertedTo", fields: [convertedPatientId], references: [id])
  convertedAt         DateTime?
  activities          LeadActivity[]
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([phone])
  @@index([ownerId, nextFollowUpAt])
  @@map("leads")
}

/// Append-only nurture/touchpoint history (REVOKE UPDATE, DELETE).
model LeadActivity {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id])
  type           LeadActivityType
  notes          String?
  actorId        String
  actor          User             @relation(fields: [actorId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// =============================================================================
// INSURANCE — insurance module. A case moves through
// eligibility -> pre-auth -> claim -> settlement; every transition is an
// append-only InsuranceCaseEvent (the communication/history log).
// Settlement records a Payment (method INSURANCE) on the linked invoice.
// No insurer API is contracted: every step is recorded by insurance staff.
// =============================================================================

enum InsuranceCaseStatus {
  ELIGIBILITY_CHECK
  PRE_AUTH_REQUESTED
  PRE_AUTH_APPROVED
  PRE_AUTH_DENIED
  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_PARTIALLY_APPROVED
  CLAIM_REJECTED
  SETTLED
  CLOSED
}

model InsurancePolicy {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  patientId       String
  patient         Patient          @relation(fields: [patientId], references: [id])
  insurerName     String
  tpaName         String?
  policyNumber    String
  memberId        String?
  sumInsuredMinor Int?
  validFrom       DateTime?        @db.Date
  validTo         DateTime?        @db.Date
  cardDocumentId  String?
  cardDocument    PatientDocument? @relation(fields: [cardDocumentId], references: [id])
  isActive        Boolean          @default(true)
  cases           InsuranceCase[]
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, deletedAt])
  @@index([patientId])
  @@map("insurance_policies")
}

model InsuranceCase {
  id                   String               @id @default(cuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id])
  patientId            String
  patient              Patient              @relation(fields: [patientId], references: [id])
  policyId             String
  policy               InsurancePolicy      @relation(fields: [policyId], references: [id])
  encounterId          String?
  encounter            Encounter?           @relation(fields: [encounterId], references: [id])
  procedureId          String?
  procedure            Procedure?           @relation(fields: [procedureId], references: [id])
  invoiceId            String?
  invoice              Invoice?             @relation(fields: [invoiceId], references: [id])
  status               InsuranceCaseStatus  @default(ELIGIBILITY_CHECK)
  requestedAmountMinor Int?
  approvedAmountMinor  Int?
  settledAmountMinor   Int?
  preAuthReference     String?
  claimReference       String?
  events               InsuranceCaseEvent[]
  createdById          String
  createdBy            User                 @relation(fields: [createdById], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([organizationId, status])
  @@index([patientId])
  @@map("insurance_cases")
}

/// Append-only (REVOKE UPDATE, DELETE): every status change and every
/// logged communication with the insurer/TPA.
model InsuranceCaseEvent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  caseId         String
  case           InsuranceCase        @relation(fields: [caseId], references: [id])
  fromStatus     InsuranceCaseStatus?
  toStatus       InsuranceCaseStatus
  amountMinor    Int?
  note           String?
  actorId        String
  actor          User                 @relation(fields: [actorId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([caseId, createdAt])
  @@map("insurance_case_events")
}

// =============================================================================
// CLINICAL TEMPLATE ENGINE — clinical-templates module. A template is a
// mutable header; its content lives in append-only versions, so a note
// records exactly which template version it started from.
// =============================================================================

model ClinicalTemplate {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id])
  name           String
  noteType       ClinicalNoteType
  specialty      String?
  isActive       Boolean                   @default(true)
  currentVersion Int                       @default(1)
  versions       ClinicalTemplateVersion[]
  createdById    String
  createdBy      User                      @relation(fields: [createdById], references: [id])
  deletedAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId, deletedAt])
  @@index([organizationId, noteType])
  @@map("clinical_templates")
}

/// Append-only (REVOKE UPDATE, DELETE). `body` holds the SOAP section
/// prompts/defaults and any structured fields, as JSON validated by
/// @serenemed/validation's clinicalTemplateBodySchema.
model ClinicalTemplateVersion {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  templateId     String
  template       ClinicalTemplate @relation(fields: [templateId], references: [id])
  version        Int
  body           Json
  notes          ClinicalNote[]
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@unique([templateId, version])
  @@index([organizationId])
  @@map("clinical_template_versions")
}

// =============================================================================
// CLINIC COMMAND CENTRE — scheduling (DoctorAvailability), StaffTask and
// Notification (notifications module). Notifications are in-app only: no
// SMS/WhatsApp/email provider is contracted.
// =============================================================================

/// A doctor's recurring weekly OPD hours (dayOfWeek 0 = Sunday,
/// clinic-local "HH:MM" times), used to compute bookable slots.
model DoctorAvailability {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  doctorId       String
  doctor         User         @relation("DoctorAvailability", fields: [doctorId], references: [id])
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  dayOfWeek      Int
  startTime      String
  endTime        String
  slotMinutes    Int          @default(15)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, doctorId, dayOfWeek])
  @@map("doctor_availability")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Team task assignment and personal reminders (assignee = creator).
model StaffTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  assigneeId     String
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  dueAt          DateTime?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, assigneeId, status])
  @@map("staff_tasks")
}

enum NotificationType {
  PHARMACY_PREPARE
  LAB_PREPARE
  LAB_RESULT_READY
  REFERRAL_RECEIVED
  FOLLOW_UP_ESCALATED
  TASK_ASSIGNED
  MESSAGE_RECEIVED
  GENERAL
}

/// In-app notification to exactly one of: a staff user, every staff
/// user with a role (first to acknowledge clears it), or a patient.
/// Titles/bodies must not carry clinical detail — they point at the
/// entity (entityType/entityId) instead.
model Notification {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  type               NotificationType
  recipientUserId    String?
  recipientUser      User?            @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientRole      StaffRole?
  recipientPatientId String?
  recipientPatient   Patient?         @relation(fields: [recipientPatientId], references: [id], onDelete: Cascade)
  title              String
  body               String?
  entityType         String?
  entityId           String?
  readAt             DateTime?
  readById           String?
  createdAt          DateTime         @default(now())

  @@index([organizationId, recipientUserId, readAt])
  @@index([organizationId, recipientRole, readAt])
  @@index([organizationId, recipientPatientId, readAt])
  @@map("notifications")
}

// =============================================================================
// PATIENT MESSAGES — messages between a patient and the clinic team.
// =============================================================================

enum MessageThreadStatus {
  OPEN
  CLOSED
}

enum MessageSenderType {
  USER
  PATIENT
}

model MessageThread {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id])
  subject        String
  status         MessageThreadStatus @default(OPEN)
  assignedToId   String?
  assignedTo     User?               @relation("ThreadAssignee", fields: [assignedToId], references: [id])
  lastMessageAt  DateTime            @default(now())
  messages       Message[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status, lastMessageAt])
  @@index([patientId])
  @@map("message_threads")
}

/// A message's body never changes once sent; only the read stamps move.
model Message {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  threadId        String
  thread          MessageThread     @relation(fields: [threadId], references: [id])
  senderType      MessageSenderType
  senderUserId    String?
  senderUser      User?             @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  body            String
  readByPatientAt DateTime?
  readByStaffAt   DateTime?
  createdAt       DateTime          @default(now())

  @@index([organizationId])
  @@index([threadId, createdAt])
  @@map("messages")
}
