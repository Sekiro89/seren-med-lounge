// SereneMed Lounge — initial Prisma schema.
//
// INTENTIONALLY MINIMAL. This bootstraps the multi-tenant shell and the
// root of the Unified Patient Record so migrations/tooling can be
// exercised end to end. It is NOT the full domain model.
//
// The proposed full ERD (Appointment, Encounter, ClinicalNote +
// versioning, Prescription, LabOrder, Invoice, Payment, InsuranceCase,
// CarePlan, AuditLog detail, etc.) is documented in
// docs/database/erd.md and gets added table-by-table as each backend
// module is implemented — see docs/architecture/domain-modules.md.
//
// Keep StaffRole in sync by hand with packages/types/src/roles.ts
// (Prisma cannot import a TS enum) until/unless we generate one from the other.
//
// SOFT DELETE CONVENTION: any model holding data that must be retained
// (i.e. almost everything except AuditLog, which is an immutable log and
// must never be deleted at all) gets a `deletedAt DateTime?` field. Adding
// that field is most of the convention — PrismaService's query extension
// (src/prisma/soft-delete.extension.ts) detects it automatically at
// runtime via the DMMF and excludes soft-deleted rows from
// find/findFirst/count by default. `.delete()`/`.deleteMany()` on these
// models throw rather than running — call `.update({ data: { deletedAt:
// new Date() } })` directly instead. (An earlier version tried to
// transparently rewrite delete->update; it silently broke tenant
// isolation inside transactions — see the comment above the delete
// handler in soft-delete.extension.ts for why.) See
// docs/architecture/security.md#soft-delete.
//
// TENANT ISOLATION: every table with organizationId (Clinic/User/Patient/
// AuditLog) has Postgres Row-Level Security policies applied in the
// migration SQL (Prisma's schema language cannot express RLS) — see
// prisma/migrations/20260921000000_init/migration.sql,
// prisma/migrations/20260921010000_audit_log_organization/migration.sql,
// and docs/architecture/security.md#row-level-security. RLS only works
// because the app connects as a non-superuser role — see
// infrastructure/docker/postgres-init/01-app-role.sql.
//
// AuditLog.organizationId is required, not optional: every actor today
// (User, Patient) already belongs to exactly one organization, so every
// auditable action has one to record. A future cross-org/platform-level
// admin action would need a different answer — not guessed at here, see
// docs/architecture/open-questions.md#9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries (the query engine) use `url` — this MUST be a
  // non-superuser role (see infrastructure/docker/postgres-init/01-app-role.sql).
  // Postgres superusers always bypass Row-Level Security, so if the app
  // connects as a superuser, the RLS tenant-isolation policies on
  // clinics/users/patients silently do nothing. `prisma migrate`
  // commands use `directUrl` instead — that one runs as the privileged
  // role, since schema changes and RLS/policy management need it.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum StaffRole {
  ADMINISTRATOR
  RECEPTION
  NURSE
  JUNIOR_DOCTOR
  SENIOR_DOCTOR
  SURGERY_COORDINATOR
  PHARMACY
  BILLING
  INSURANCE
  MARKETING
}

/// Tenancy root. A deployment can host multiple organizations later;
/// today there is exactly one, but every table hangs off this from day one.
model Organization {
  id        String     @id @default(cuid())
  name      String
  clinics   Clinic[]
  users     User[]
  patients  Patient[]
  auditLogs AuditLog[]
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([deletedAt])
  @@map("organizations")
}

/// A physical/operational clinic location under an organization.
model Clinic {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  users          User[]
  patients       Patient[]
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, deletedAt])
  @@map("clinics")
}

/// Staff identity — NOT the patient identity (see Patient below). Kept
/// separate deliberately: staff auth/roles and patient auth/consent are
/// different concerns and must never be merged into one "users" table.
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  email          String
  passwordHash   String
  fullName       String
  role           StaffRole
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Scoped to the organization, not global — the same person can hold
  // separate staff accounts at two different organizations under one
  // email. See docs/architecture/open-questions.md.
  //
  // NOTE: this constraint does not account for deletedAt — re-inviting a
  // soft-deleted former staff member under the same email will hit this
  // unique constraint rather than silently reusing the row. That's
  // deliberate for now (forces an explicit "restore" action instead of a
  // surprise reactivation); see docs/architecture/security.md#soft-delete.
  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([clinicId])
  @@map("users")
}

/// Root of the Unified Patient Record. Every other domain (clinical,
/// billing, pharmacy, follow-up, CRM/lead-once-converted, timeline) will
/// attach to this same Patient row by patientId — never duplicated per
/// module. See docs/database/erd.md.
model Patient {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  phone          String
  email          String?
  passwordHash   String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, deletedAt])
  @@index([clinicId])
  @@index([phone])
  @@map("patients")
}

/// Foundational audit trail — see docs/architecture/security.md.
/// Detailed per-domain audit needs (e.g. clinical note amendment history)
/// get their own tables later; this is the generic cross-cutting log.
///
/// No deletedAt — an audit trail must never be deletable, soft or
/// otherwise (see the SOFT DELETE CONVENTION note above).
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorType      String // "USER" | "PATIENT" | "SYSTEM"
  actorId        String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
